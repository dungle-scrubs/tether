{
  "name": "tether-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "db:generate": "pnpm --filter tether db:generate",
    "db:push": "pnpm --filter tether db:push",
    "dev": "pnpm --filter tether dev",
    "format": "biome format --config-path=tooling/biome.json --write .",
    "format:check": "biome format --config-path=tooling/biome.json .",
    "lint": "biome lint --config-path=tooling/biome.json .",
    "prepare": "lefthook install",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "start": "pnpm --filter tether start",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter tether test:e2e",
    "typecheck": "turbo run typecheck",
    "ui": "pnpm --filter tether ui",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "lefthook": "^2.1.8",
    "turbo": "^2.6.1",
    "typescript": "^6.0.3"
  }
}
