AUTH_MODE=required
AUTH_SIGNING_KID=default
AUTH_SIGNING_SECRET=replace-with-random-server-secret
AUTH_ISSUER=https://auth.example.com
RUNTIME_TOPOLOGY=single
POSTGRES_DB=tether
POSTGRES_USER=tether
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=54329
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=3025
DATABASE_URL=postgres://tether:replace-with-url-encoded-local-password@postgres:5432/tether
EVENT_FANOUT_CATCH_UP_STALE_MS=30000
SERVICE_AUTH_TOKEN=replace-with-token-minted-by-pnpm-filter-tether-mint
