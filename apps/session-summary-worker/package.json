{
  "name": "@dungle-scrubs/session-summary-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "biome format --config-path=../../tooling/biome.json --write .",
    "format:check": "biome format --config-path=../../tooling/biome.json .",
    "lint": "biome lint --config-path=../../tooling/biome.json .",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@dungle-scrubs/tether-client": "workspace:*",
    "@dungle-scrubs/tether-protocol": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "vitest": "^4.1.7"
  }
}
